# ── API do RCSGestão (dados desportivos, só de leitura) ───────────────────
# URL base da API de leitura exposta pelo RCSGestão.
RCSGESTAO_API_URL="https://gestao.exemplo.pt/api/public"
# Token opcional se a API exigir autenticação de leitura.
RCSGESTAO_API_TOKEN=""

# ── Loja (fase 1) ────────────────────────────────────────────────────────
# Resend — envio de email de confirmação de encomenda.
RESEND_API_KEY=""
# Remetente e destino das notificações de encomenda.
ENCOMENDAS_FROM_EMAIL="loja@realclubesenhorense.pt"
ENCOMENDAS_TO_EMAIL="loja@realclubesenhorense.pt"

# Upstash Redis — registo das encomendas para consulta posterior.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
